# ─── WellnessBlock AI - Environment Configuration ───────────────────────────
# Copy this file to .env and fill in production values.
# Do NOT commit .env to source control.

# Runtime mode: 'local' or 'aws'
# local = No AWS credentials needed (default for development)
# aws   = Uses real AWS services (Cognito, DynamoDB, Bedrock)
BLOCK_RUNTIME=local

# ─── AWS Configuration (required when BLOCK_RUNTIME=aws) ────────────────────

# AWS Region
AWS_REGION=us-east-1

# Amazon Cognito (AuthBlock)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Amazon DynamoDB (DataBlock)
DYNAMODB_TABLE_NAME=WellnessRecords-production

# Amazon Bedrock (AiInsightBlock)
# Supported models: anthropic.claude-3-haiku-20240307-v1:0, anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# API Gateway endpoint (for frontend in production)
API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# ─── Local Development ──────────────────────────────────────────────────────
# These are only used when BLOCK_RUNTIME=local (no configuration needed)
# Local auth uses deterministic test users (alice, bob, admin)
# Local data uses JSON files in .data/ directory
# Local AI uses deterministic summary generation
