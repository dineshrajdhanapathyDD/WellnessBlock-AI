{
  "name": "wellnessblock-ai",
  "version": "2.0.0",
  "description": "WellnessBlock AI - Block-based wellness tracker with local and AWS production runtimes",
  "private": true,
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "reset": "tsx src/scripts/reset.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/tests/contract.test.ts",
    "validate:aws": "tsx src/scripts/validate-aws.ts",
    "synth": "tsx src/scripts/validate-aws.ts",
    "deploy": "aws cloudformation deploy --template-file infra/cloudformation.yaml --stack-name WellnessBlockAI --capabilities CAPABILITY_NAMED_IAM --parameter-overrides Environment=production"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.450.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.450.0",
    "@aws-sdk/client-dynamodb": "^3.450.0",
    "@aws-sdk/lib-dynamodb": "^3.450.0",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2"
  }
}
